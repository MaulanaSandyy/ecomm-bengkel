# ============================================
# ENVIRONMENT CONFIGURATION
# Copy file ini menjadi .env dan isi dengan data asli
# ============================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=bengkel_mobil

# Xendit API Configuration (Development)
# Untuk production, gunakan API key production
XENDIT_API_KEY=your_xendit_api_key_here
XENDIT_CALLBACK_TOKEN=your_callback_token_here

# Application Settings
APP_ENV=development
APP_DEBUG=true